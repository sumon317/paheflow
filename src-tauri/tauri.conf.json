{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaheFlow",
  "version": "1.0.0",
  "identifier": "com.paheflow.gui",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "windows": [
      {
        "title": "PaheFlow",
        "width": 1280,
        "height": 840,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "AudioVideo",
    "shortDescription": "Native AnimePahe GUI & HLS Downloader",
    "longDescription": "High-performance native Linux AnimePahe desktop manager written in Rust with concurrent HLS streaming and offline library management."
  }
}
