#!/usr/bin/env bash
# AnimePahe GUI Native (Rust) Launcher

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$SCRIPT_DIR/target/release/animepahe-gui"

# Run from the project root so the server finds static/ and anime.list and
# keeps config.json/cache in project mode.
cd "$SCRIPT_DIR"

# Ensure Cargo/Rust is in PATH if installed via rustup
if [[ -d "$HOME/.cargo/bin" ]]; then
    export PATH="$HOME/.cargo/bin:$PATH"
fi

if [[ -d "$HOME/.local/bin" ]]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# Tools installed by requirements.sh live inside the project.
if [[ -d "$SCRIPT_DIR/.uv/bin" ]]; then
    export PATH="$SCRIPT_DIR/.uv/bin:$PATH"
fi

# Build release binary if not present
if [[ ! -x "$BIN" ]]; then
    if ! command -v cargo >/dev/null 2>&1; then
        echo "error: cargo was not found. Install Rust from https://rustup.rs and retry." >&2
        exit 1
    fi
    echo "Building native AnimePahe GUI (Rust)..."
    cargo build --release --manifest-path "$SCRIPT_DIR/Cargo.toml"
fi

exec "$BIN" "$@"
